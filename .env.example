# Generated by saas-core factory — preset agentsec-mvp

# ── Service identity ────────────────────────────────────────────────────────
# Public service name shown in the header and browser tab
NEXT_PUBLIC_SERVICE_NAME=McpGuard Lite
# Short tagline shown on the landing page
NEXT_PUBLIC_SERVICE_TAGLINE=Real-time MCP security for AI agents

# ── auth.clerk ──────────────────────────────────────────────────────────────
# Clerk publishable key (pk_test_... or pk_live_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (sk_test_... or sk_live_...)
CLERK_SECRET_KEY=
# Sign-in route
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Sign-up route
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Redirect destination after sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# Redirect destination after sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── db.postgres.prisma ──────────────────────────────────────────────────────
# Supabase pooled connection string (Transaction mode, port 6543)
DATABASE_URL=
# Supabase direct connection string (Session mode, port 5432) — used by Prisma Migrate
DIRECT_URL=
# Supabase project URL (used by the Supabase JS client if needed)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous/public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key (server-side only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ── ai.core ─────────────────────────────────────────────────────────────────
# OpenAI API key (sk-...)
OPENAI_API_KEY=
# Model to use for risk assessment (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── security.analytics ──────────────────────────────────────────────────────
# PostHog project API key (optional — events are persisted to DB regardless)
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host (default: https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── mcp.rest ────────────────────────────────────────────────────────────────
# Shared secret for verifying inbound MCP requests from agents
# Generate with: openssl rand -hex 32
MCP_API_SECRET=

